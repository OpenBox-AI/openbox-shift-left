{
  "version": "example-2026-07-13",
  "default_decision": "allow",
  "rules": [
    {
      "id": "no-recursive-root-delete",
      "match": {
        "event_type": "ToolCall",
        "tool_kind": "shell",
        "attribute_contains": { "command": "rm -rf /" }
      },
      "decision": "block",
      "reason": "recursive delete of a root path is blocked by policy",
      "policy_id": "shell.destructive.rm-rf-root"
    },
    {
      "id": "protect-secrets-files",
      "match": {
        "event_type": "ToolCall",
        "tool_kind": "file",
        "attribute_contains": { "file_path": "/etc/shadow" }
      },
      "decision": "block",
      "reason": "writing system credential files is blocked by policy",
      "policy_id": "file.sensitive.shadow"
    },
    {
      "id": "constrain-env-writes",
      "match": {
        "event_type": "ToolCall",
        "tool_kind": "file",
        "attribute_contains": { "file_path": ".env" }
      },
      "decision": "constrain",
      "reason": "writes to .env files are recorded with a constraint",
      "policy_id": "file.sensitive.dotenv",
      "constraints": [{ "type": "audit", "note": "dotenv write" }]
    },
    {
      "id": "approve-github-mcp-mutations",
      "match": {
        "event_type": "ToolCall",
        "tool_kind": "mcp",
        "mcp_server": "github"
      },
      "decision": "require_approval",
      "reason": "MCP github mutations require developer approval",
      "policy_id": "mcp.github.require-approval"
    }
  ]
}

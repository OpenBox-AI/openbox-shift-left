// Workspace over every module in this repo.
//
// The repo is split into 12 modules that reference each other through relative
// `replace` directives. Without a workspace there is no way to build or test
// the repo as a whole — `go build ./...` only ever sees one module — which is
// how `main` came to have no verification at all. The workspace gives CI (and
// gopls) a single view; the `replace` directives stay authoritative for anyone
// building a module on its own.
//
// The release build sets GOWORK=off (see .goreleaser.yaml) so a published
// binary resolves exactly as it would outside this checkout.
go 1.23.0

use (
	./actions/openbox-git-action
	./adapters/claude-code
	./adapters/codex
	./adapters/common/devconfig
	./adapters/common/git
	./adapters/common/hookflow
	./cli
	./client
	./contracts/dev-event/conformance
	./decision
	./gateway
	./provider
)

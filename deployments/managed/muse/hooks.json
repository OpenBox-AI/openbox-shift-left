{
  "schema_version": 1,
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"OPENBOX_BIN\" hook muse SessionStart",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"OPENBOX_BIN\" hook muse UserPromptSubmit",
            "timeout": 30,
            "onFailure": {
              "type": "command",
              "command": "\"OPENBOX_BIN\" hook muse --fail-closed UserPromptSubmit",
              "timeout": 5
            }
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"OPENBOX_BIN\" hook muse PreToolUse",
            "timeout": 30,
            "onFailure": {
              "type": "command",
              "command": "\"OPENBOX_BIN\" hook muse --fail-closed PreToolUse",
              "timeout": 5
            }
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"OPENBOX_BIN\" hook muse PermissionRequest",
            "timeout": 30,
            "onFailure": {
              "type": "command",
              "command": "\"OPENBOX_BIN\" hook muse --fail-closed PermissionRequest",
              "timeout": 5
            }
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"OPENBOX_BIN\" hook muse PostToolUse",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"OPENBOX_BIN\" hook muse PostToolUseFailure",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"OPENBOX_BIN\" hook muse SubagentStart",
            "timeout": 5
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"OPENBOX_BIN\" hook muse StopFailure",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"OPENBOX_BIN\" hook muse SessionEnd",
            "timeout": 3
          }
        ]
      }
    ],
    "PreLLMCall": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"OPENBOX_BIN\" hook muse PreLLMCall",
            "timeout": 30,
            "onFailure": {
              "type": "command",
              "command": "\"OPENBOX_BIN\" hook muse --fail-closed PreLLMCall",
              "timeout": 5
            }
          }
        ]
      }
    ],
    "PostLLMCall": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"OPENBOX_BIN\" hook muse PostLLMCall",
            "timeout": 5
          }
        ]
      }
    ]
  }
}

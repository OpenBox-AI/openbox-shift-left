+	// terminal, the rest are looked-up-in-session events.
+	EventTypeSessionStarted  = "SessionStarted"
+	EventTypePromptSubmitted = "PromptSubmitted"
+	EventTypeToolCall        = "ToolCall"
+	EventTypeToolResult      = "ToolResult"
+	EventTypeSessionEnded    = "SessionEnded"
+	EventTypeCommitCreated   = "CommitCreated"
+	EventTypeDeploy          = "Deploy"

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ai.openbox.project-security-report.manifest/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "pack_schema", "payloads", "pack_digest", "finalized_at"],
  "properties": {
    "schema": { "const": "ai.openbox.project-security-report.manifest/v1" },
    "pack_schema": { "const": "ai.openbox.project-security-report/v1" },
    "payloads": {
      "type": "array",
      "minItems": 14,
      "maxItems": 14,
      "items": { "$ref": "#/$defs/descriptor" }
    },
    "pack_digest": { "$ref": "#/$defs/digest" },
    "finalized_at": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "descriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "media_type", "bytes", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1, "maxLength": 128 },
        "media_type": { "enum": ["application/json", "application/x-ndjson", "text/markdown", "application/sarif+json"] },
        "bytes": { "type": "integer", "minimum": 0, "maximum": 75497472 },
        "sha256": { "$ref": "#/$defs/digest" }
      }
    }
  }
}


  "npm": "11.6.2",
  "install_command": [
    "/Users/lebrian/.nvm/versions/node/v22.20.0/bin/npm",
    "install",
    "--prefix",
    "QUALIFICATION_DIR",
    "--ignore-scripts",
    "--no-audit",
    "--no-fund",
    "--package-lock=false",
    "--save-exact",
    "ajv@8.17.1",
    "fast-deep-equal@3.1.3",
    "fast-uri@3.1.5",
    "json-schema-traverse@1.0.0",
    "require-from-string@2.0.2"
  ],
  "verification_environment": {
    "QUALIFICATION_DIR": "caller-created directory passed to --prefix",
    "LOCK_FILE": "path to this qualification lock"
  },
  "verify_package_json_command": [
    "/bin/zsh",
    "-c",
    "jq -r --arg root \"$QUALIFICATION_DIR\" '.packages[] | \"\\(.package_json_sha256)  \\($root)/node_modules/\\(.name)/package.json\"' \"$LOCK_FILE\" | shasum -a 256 -c -"
  ],
  "verify_registry_integrity_command": [
    "jq",
    "-s",
    "-e",
    "([.[0].packages[] | {name,version,resolved,integrity}] | sort_by(.name)) == ([.[1].packages | to_entries[] | {name:(.key | split(\"/\")[-1]),version:.value.version,resolved:.value.resolved,integrity:.value.integrity}] | sort_by(.name))",
    "LOCK_FILE",
    "QUALIFICATION_DIR/node_modules/.package-lock.json"
  ],

# Local editor/agent tooling state (never project content)
.claude/
.fab7/
.codegraph/

# OS / editor cruft
.DS_Store
Thumbs.db
*.swp
*~
.idea/
.vscode/

# Build output (compiled Go binaries — built per-platform, never committed).
# `go build ./...` in a `main` package writes the binary into the current
# directory, so a cross-compile gate can leave one beside the source.
bin/
/openbox
*.exe

# Env / secrets
.env
.env.*
!.env.example

# Local working notes and scratch evidence; never part of the published tree.
plans/
.probe-evidence/

# `tools/` holds source only: goreleaser builds none of it, and a committed
# binary is a supply chain nobody reviewed. Allow-list rather than
# pattern-match the artefacts — `go build` with no -o drops a binary named
# after its directory, which no extension rule can catch.
/tools/**
!/tools/**/
!/tools/**/*.go
!/tools/**/*.md

# GoReleaser output (config lives under build/, artefacts land in dist/).
/dist/

# Claude Code tooling (local tooling, not project content)
.claude/

# OS / editor cruft
.DS_Store
Thumbs.db
*.swp
*~
.idea/
.vscode/

# Build output (compiled Go binaries — built per-platform, never committed)
bin/
/openbox

# `go build ./...` in a module whose package is `main` writes the binary into the
# CURRENT directory, so a routine cross-compile gate leaves one beside the source.
# That is how 18 MB of untracked binaries came to be sitting in
# probes/refusal-injector/ where `git status` showed only the directory — an
# untracked directory hides its contents, so no review would have seen them.
*.exe
probes/refusal-injector/refusal-injector

# Env / secrets
.env
.env.*
!.env.example

# Testbed local state (config isolation, minted credentials, session output)
testbed/.state/
testbed/env.local.sh

# Local agent tooling state (never project content)
.fab7/

# Supplied API dumps used as one-off probe evidence. Real governance data:
# agent, session and run identifiers from a live org. They belong in a report,
# never in the tree of a PUBLIC repo — f6690e7 committed them by accident,
# against a decision already written down in plans/reports/.
.probe-evidence/

# .env.sandbox — the project's environment for a sandbox evaluation.
#
# An ordinary dotenv file. Copy the project's own .env here and change what the
# sandbox needs; nothing is renamed and nothing is prefixed.
#
# It is a SEPARATE file from .env on purpose. The evaluator never reads .env or
# .env.local, so a run carries only what was copied here deliberately — and a
# project can point the sandbox at test credentials while local development
# keeps using its own.
#
# Every variable reaches the workload in plaintext. Names that look like
# credentials are named in a warning when the run starts as supplied in plaintext
# and not bound to an endpoint, so a reader can tell which credentials were governed.
# The one governed credential is OPENBOX_API_KEY, which the evaluator supplies
# through the gateway and which must not appear here.

NODE_ENV=production

OPENAI_BASE_URL=https://inference.local/v1
OPENAI_MODEL=granite4.1:3b
# The gateway injects the real inference credential at the inference.local
# route (an OpenShell inference route to the local Ollama); the SDK only
# requires the variable be present.
OPENAI_API_KEY=unused

# .env.sandbox — the project's environment for a sandbox evaluation.
#
# An ordinary dotenv file. Copy the project's own .env here and change what the
# sandbox needs; nothing is renamed and nothing is prefixed.
#
# It is a SEPARATE file from .env on purpose. The evaluator never reads .env or
# .env.local, so a run carries only what was copied here deliberately — and a
# project can point the sandbox at test credentials while local development
# keeps using its own.
#
# Every variable reaches the workload in plaintext. Names that look like
# credentials are listed in the sealed pack as supplied in plaintext and not
# bound to an endpoint, so a reader can tell which credentials were governed.
# The one governed credential is OPENBOX_API_KEY, which the evaluator supplies
# through the gateway and which must not appear here.

NODE_ENV=production

OPENAI_BASE_URL=https://inference.local/v1
OPENAI_MODEL=granite4.1:3b
# The gateway injects the real inference credential at the inference.local
# route; the SDK only requires the variable be present.
OPENAI_API_KEY=unused

# Runner directives, not project environment. These keep an OPENBOX_SANDBOX_
# prefix so they cannot collide with a variable the workload wants, and they are
# never passed to the guest.
#
# OPENBOX_SANDBOX_MODEL_ROUTE selects what serves inference.local:
#   local-ollama  an Ollama on this host — the host proves the model is present
#                 and cold before the run
#   gateway       OpenAI, Gemini, OpenRouter, a remote Ollama; nothing here to
#                 preflight, and the route is recorded as unproven
OPENBOX_SANDBOX_MODEL_ROUTE=local-ollama
OPENBOX_SANDBOX_MODEL_DIGEST=sha256:6fd349357287c7ffc9e38189a93b48ea175d24fc566b38f09cfc564fb7f303eb

# .env.sandbox — what this project needs INSIDE the sandbox.
#
# Deliberately not the project's own .env / .env.local. Those describe how it
# runs on a developer's machine and routinely hold real credentials; the
# evaluator never reads them, so nothing leaks into a run by accident. What
# crosses the boundary is what is written here on purpose.
#
# Three channels:
#   BARE_NAME=value                        non-secret application default
#   OPENBOX_SANDBOX_PUBLIC_NAME=value      explicit; a credential-SHAPED name
#                                          declared public is a stand-in
#   OPENBOX_SANDBOX_SECRET_NAME=value      never reaches the guest as a value;
#                                          resolved as a gateway credential

NODE_ENV=production

# Which model backend serves the gateway's inference.local route.
#   local-ollama  an Ollama on this host — the host proves the model is
#                 present and cold before the run
#   gateway       OpenAI, Gemini, OpenRouter, a remote Ollama; nothing here to
#                 preflight, and the route is recorded as unproven
OPENBOX_SANDBOX_MODEL_ROUTE=local-ollama
OPENBOX_SANDBOX_MODEL_DIGEST=sha256:6fd349357287c7ffc9e38189a93b48ea175d24fc566b38f09cfc564fb7f303eb

OPENBOX_SANDBOX_PUBLIC_OPENAI_MODEL=granite4.1:3b
OPENBOX_SANDBOX_PUBLIC_OPENAI_BASE_URL=https://inference.local/v1
# A stand-in, not a credential: the gateway injects the real inference key at
# the inference.local route. The SDK only requires the variable be present.
OPENBOX_SANDBOX_PUBLIC_OPENAI_API_KEY=unused

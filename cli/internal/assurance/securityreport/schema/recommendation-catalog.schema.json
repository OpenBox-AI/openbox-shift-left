{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ai.openbox.project-recommendation-catalog/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "read_contract", "entries"],
  "properties": {
    "schema": { "const": "ai.openbox.project-recommendation-catalog/v1" },
    "version": { "const": "2026-08-27-mvp1" },
    "read_contract": { "const": "local-dashboard-control-read/v1" },
    "entries": {
      "type": "array", "minItems": 6, "maxItems": 6,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "kind", "standard_ids", "action_classes", "permission", "route", "constraint", "limitations"],
        "properties": {
          "id": { "enum": ["prompt-input", "model-output", "effect-sequence", "least-privilege", "human-authorization", "observation-gap"] },
          "kind": { "enum": ["guardrail", "behavior_rule", "policy", "approval_requirement", "sdk_integration"] },
          "standard_ids": { "type": "array", "minItems": 1, "maxItems": 7, "uniqueItems": true, "items": { "type": "string", "pattern": "^(ASI0[12]|LLM0[16]|CWE-142[67]|AML\\.T0051)$" } },
          "action_classes": { "type": "array", "maxItems": 32, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$" } },
          "permission": { "type": "string", "pattern": "^read:[a-z_]+$" },
          "route": { "type": "string", "minLength": 1, "maxLength": 128 },
          "constraint": { "enum": ["neutralize_untrusted_prompt_input", "validate_model_output_before_effect", "constrain_effect_sequence", "limit_action_authority", "require_human_authorization", "instrument_missing_semantic_authority"] },
          "limitations": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "type": "string", "minLength": 1, "maxLength": 240 } }
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openbox.sandbox-posture/v1",
  "title": "OpenBox sandbox posture v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "driver", "platform", "configurationDigest", "parent", "child", "overall", "limits"],
  "properties": {
    "apiVersion": { "const": "openbox.sandbox-posture/v1" },
    "kind": { "const": "SandboxPosture" },
    "driver": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "mode"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 128 },
        "version": { "type": "string", "minLength": 1, "maxLength": 128 },
        "mode": { "enum": ["standalone", "inherited"] }
      }
    },
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["os", "arch", "version"],
      "properties": {
        "os": { "type": "string", "minLength": 1, "maxLength": 64 },
        "arch": { "type": "string", "minLength": 1, "maxLength": 64 },
        "version": { "type": "string", "minLength": 1, "maxLength": 256 }
      }
    },
    "configurationDigest": { "$ref": "#/$defs/digest" },
    "parent": { "$ref": "#/$defs/parentCapabilitySet" },
    "child": { "$ref": "#/$defs/childCapabilitySet" },
    "overall": { "enum": ["qualified", "rejected", "inconclusive", "not_runnable"] },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["probeCount", "timeoutMs"],
      "properties": {
        "probeCount": { "$ref": "#/$defs/nonNegativeInteger" },
        "timeoutMs": { "$ref": "#/$defs/nonNegativeInteger" }
      }
    }
  },
  "allOf": [
    {
      "if": { "type": "object", "properties": { "overall": { "const": "qualified" } }, "required": ["overall"] },
      "then": {
        "type": "object",
        "properties": {
          "parent": { "$ref": "#/$defs/passedParentCapabilitySet" },
          "child": { "$ref": "#/$defs/passedChildCapabilitySet" }
        }
      }
    }
  ],
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "nonNegativeInteger": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "evidence", "detail"],
      "properties": {
        "status": { "enum": ["passed", "failed", "inconclusive", "not_runnable"] },
        "evidence": { "type": "array", "minItems": 1, "maxItems": 64, "items": { "$ref": "#/$defs/digest" } },
        "detail": { "type": "string", "minLength": 1, "maxLength": 4096 }
      }
    },
    "passedObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "evidence", "detail"],
      "properties": {
        "status": { "const": "passed" },
        "evidence": { "type": "array", "minItems": 1, "maxItems": 64, "items": { "$ref": "#/$defs/digest" } },
        "detail": { "type": "string", "minLength": 1, "maxLength": 4096 }
      }
    },
    "parentCapabilitySet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["filesystemRead", "filesystemWrite", "networkExternal", "networkLoopback", "credentials", "fallback", "timeout", "cleanup"],
      "properties": {
        "filesystemRead": { "$ref": "#/$defs/observation" },
        "filesystemWrite": { "$ref": "#/$defs/observation" },
        "networkExternal": { "$ref": "#/$defs/observation" },
        "networkLoopback": { "$ref": "#/$defs/observation" },
        "credentials": { "$ref": "#/$defs/observation" },
        "fallback": { "$ref": "#/$defs/observation" },
        "timeout": { "$ref": "#/$defs/observation" },
        "cleanup": { "$ref": "#/$defs/observation" }
      }
    },
    "childCapabilitySet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["filesystemRead", "filesystemWrite", "networkExternal", "networkLoopback", "credentials", "fallback", "timeout", "cleanup", "inheritance"],
      "properties": {
        "filesystemRead": { "$ref": "#/$defs/observation" },
        "filesystemWrite": { "$ref": "#/$defs/observation" },
        "networkExternal": { "$ref": "#/$defs/observation" },
        "networkLoopback": { "$ref": "#/$defs/observation" },
        "credentials": { "$ref": "#/$defs/observation" },
        "fallback": { "$ref": "#/$defs/observation" },
        "timeout": { "$ref": "#/$defs/observation" },
        "cleanup": { "$ref": "#/$defs/observation" },
        "inheritance": { "$ref": "#/$defs/observation" }
      }
    },
    "passedParentCapabilitySet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["filesystemRead", "filesystemWrite", "networkExternal", "networkLoopback", "credentials", "fallback", "timeout", "cleanup"],
      "properties": {
        "filesystemRead": { "$ref": "#/$defs/passedObservation" },
        "filesystemWrite": { "$ref": "#/$defs/passedObservation" },
        "networkExternal": { "$ref": "#/$defs/passedObservation" },
        "networkLoopback": { "$ref": "#/$defs/passedObservation" },
        "credentials": { "$ref": "#/$defs/passedObservation" },
        "fallback": { "$ref": "#/$defs/passedObservation" },
        "timeout": { "$ref": "#/$defs/passedObservation" },
        "cleanup": { "$ref": "#/$defs/passedObservation" }
      }
    },
    "passedChildCapabilitySet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["filesystemRead", "filesystemWrite", "networkExternal", "networkLoopback", "credentials", "fallback", "timeout", "cleanup", "inheritance"],
      "properties": {
        "filesystemRead": { "$ref": "#/$defs/passedObservation" },
        "filesystemWrite": { "$ref": "#/$defs/passedObservation" },
        "networkExternal": { "$ref": "#/$defs/passedObservation" },
        "networkLoopback": { "$ref": "#/$defs/passedObservation" },
        "credentials": { "$ref": "#/$defs/passedObservation" },
        "fallback": { "$ref": "#/$defs/passedObservation" },
        "timeout": { "$ref": "#/$defs/passedObservation" },
        "cleanup": { "$ref": "#/$defs/passedObservation" },
        "inheritance": { "$ref": "#/$defs/passedObservation" }
      }
    }
  }
}

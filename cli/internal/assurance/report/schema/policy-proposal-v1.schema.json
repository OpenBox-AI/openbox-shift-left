{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openbox.policy-proposal/v1",
  "title": "OpenBox inert policy proposal v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "id", "findingId", "scenarioId", "baselinePackDigest", "reachability", "candidate", "requiredInterceptionEvidence", "risks", "rerun", "authority"],
  "properties": {
    "apiVersion": { "const": "openbox.policy-proposal/v1" },
    "kind": { "const": "PolicyProposal" },
    "id": { "$ref": "#/$defs/id" },
    "findingId": { "$ref": "#/$defs/id" },
    "scenarioId": { "$ref": "#/$defs/id" },
    "baselinePackDigest": { "$ref": "#/$defs/digest" },
    "reachability": { "enum": ["runtime_enforceable", "host_enforceable", "observable_only", "code_change_required", "blind"] },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "target", "documentDigest", "expectedVerdict", "failurePolicy", "integrationLocation"],
      "properties": {
        "type": { "enum": ["runtime_policy", "host_policy", "code_change", "observability"] },
        "target": { "type": "string", "minLength": 1, "maxLength": 512 },
        "documentDigest": { "$ref": "#/$defs/digest" },
        "expectedVerdict": { "const": "BLOCK" },
        "failurePolicy": { "enum": ["fail_closed", "fail_open", "not_applicable"] },
        "integrationLocation": { "type": "string", "minLength": 1, "maxLength": 4096 }
      }
    },
    "requiredInterceptionEvidence": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["field", "stage", "available"],
        "properties": {
          "field": { "type": "string", "minLength": 1, "maxLength": 256 },
          "stage": { "enum": ["pre_effect", "post_effect", "unobserved"] },
          "available": { "type": "boolean" }
        }
      }
    },
    "risks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "description"],
        "properties": {
          "type": { "enum": ["false_positive", "false_negative", "operational", "coverage", "rollback"] },
          "description": { "type": "string", "minLength": 1, "maxLength": 4096 }
        }
      }
    },
    "rerun": {
      "type": "object",
      "additionalProperties": false,
      "required": ["projectSnapshotDigest", "scenarioDigest", "sdkCoverageDigest", "sandboxPostureDigest", "requiredOutcome", "repetitions"],
      "properties": {
        "projectSnapshotDigest": { "$ref": "#/$defs/digest" },
        "scenarioDigest": { "$ref": "#/$defs/digest" },
        "sdkCoverageDigest": { "$ref": "#/$defs/digest" },
        "sandboxPostureDigest": { "$ref": "#/$defs/digest" },
        "requiredOutcome": { "const": "blocked" },
        "repetitions": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "sourceEdits", "externalWrites", "deployment"],
      "properties": {
        "status": { "const": "inert" },
        "sourceEdits": { "const": false },
        "externalWrites": { "const": false },
        "deployment": { "const": false }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "type": "object",
        "properties": {
          "candidate": {
            "type": "object",
            "properties": { "type": { "const": "runtime_policy" } },
            "required": ["type"]
          }
        },
        "required": ["candidate"]
      },
      "then": {
        "type": "object",
        "properties": {
          "reachability": { "const": "runtime_enforceable" },
          "requiredInterceptionEvidence": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "stage": { "const": "pre_effect" },
                "available": { "const": true }
              },
              "required": ["stage", "available"]
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "id": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$" },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  }
}
